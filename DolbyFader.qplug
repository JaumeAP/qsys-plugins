--*** File header comment ***
-- Dolby Fader for Q-SYS
-- by james.puig@dolby.com
-- Sept '20
-- v2.0: rebuilt to the QSC-derived plugin structure/naming convention
-- (Developer/tests + qsc-q-sys/components_emulator/docs/qsys-plugins.md).
-- Signal chain: a Text control ('Level') mirrors the Dolby 0.0-10.0 scale,
-- kept in sync with the 'Gain' Knob (dB) and an embedded stepper component
-- via qknob.lua/dolbyfader.lua. No network I/O in this plugin.

--*** PluginInfo ***

PluginInfo = {
	Name = "Dolby~Dolby Fader",
	Version = "2.0",
	BuildVersion = "2.0.0.0",
	Id = "a07f3b34-09af-4c25-af2d-be47d00bb4e9",
	Author = "(c) Jaume Puig, Barcelona",
	Description = "Dolby Fader Component Plugin",
}

-- Enums are needed at design time (GetControls/GetControlLayout), so this
-- module is required unconditionally, before the runtime guard below --
-- unlike the rest of Developer/Modules, which only loads after it.

--*** Design-time: Identity ***

function GetColor(props)
	return { 204, 204, 204 }
end

function GetPrettyName(props)
	return "Dolby Fader "
end

--*** Design-time: Properties ***

function GetProperties()
	return {}
end

function RectifyProperties(props)
	props.plugin_show_debug.IsHidden = true
	return props
end

--*** Design-time: Controls ***

function GetControls(props)
	local ctrls = {}

	table.insert(ctrls, {
		Name = "Ref",
		ControlType = ControlType.BUTTON,
		ButtonType = ButtonType.MOMENTARY,
	})

	table.insert(ctrls, {
		Name = "Level",
		ControlType = ControlType.TEXT,
		UserPin = true,
		PinStyle = PinStyle.BOTH,
	})

	table.insert(ctrls, {
		Name = "Gain",
		ControlType = ControlType.KNOB,
		ControlUnit = ControlUnit.DB,
		Min = -100,
		Max = 20,
		PinStyle = PinStyle.BOTH,
	})

	table.insert(ctrls, {
		Name = "Increase",
		ControlType = ControlType.BUTTON,
		ButtonType = ButtonType.MOMENTARY,
		IconType = "Icon",
		Icon = "Plus",
		IconColor = { 0, 0, 0 },
	})

	table.insert(ctrls, {
		Name = "Decrease",
		ControlType = ControlType.BUTTON,
		ButtonType = ButtonType.MOMENTARY,
		IconType = "Icon",
		Icon = "Minus",
		IconColor = { 0, 0, 0 },
	})

	return ctrls
end

--*** Design-time: Layout ***

