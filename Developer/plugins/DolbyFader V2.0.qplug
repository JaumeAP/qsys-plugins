--*** File header comment ***
-- Dolby Fader for Q-SYS
-- by james.puig@dolby.com
-- Sept '20
-- v2.0: rebuilt to the QSC-derived plugin structure/naming convention
-- (Developer/tests + qsc-q-sys/components_emulator/docs/qsys-plugins.md).
-- Signal chain: a Text control ('Level') mirrors the Dolby 0.0-10.0 scale,
-- kept in sync with the 'Gain' Knob (dB) and an embedded stepper component
-- via qknob.lua/dolbyfader.lua. No network I/O in this plugin.

--*** PluginInfo ***

PluginInfo = {
	Name = "Dolby~Dolby Fader",
	Version = "2.0",
	BuildVersion = "2.0.0.0",
	Id = "a07f3b34-09af-4c25-af2d-be47d00bb4e9",
	Author = "(c) Jaume Puig, Barcelona",
	Description = "Dolby Fader Component Plugin",
}

-- Enums are needed at design time (GetControls/GetControlLayout), so this
-- module is required unconditionally, before the runtime guard below --
-- unlike the rest of Developer/Modules, which only loads after it.
require "qsys_enums"

--*** Design-time: Identity ***

function GetColor(props)
	return { 204, 204, 204 }
end

function GetPrettyName(props)
	return "Dolby Fader "
end

--*** Design-time: Properties ***

function GetProperties()
	return {}
end

function RectifyProperties(props)
	props.plugin_show_debug.IsHidden = true
	return props
end

--*** Design-time: Controls ***

function GetControls(props)
	local ctrls = {}

	table.insert(ctrls, {
		Name = "Ref",
		ControlType = ControlType.BUTTON,
		ButtonType = ButtonType.MOMENTARY,
	})

	table.insert(ctrls, {
		Name = "Level",
		ControlType = ControlType.TEXT,
		UserPin = true,
		PinStyle = PinStyle.BOTH,
	})

	table.insert(ctrls, {
		Name = "Gain",
		ControlType = ControlType.KNOB,
		ControlUnit = ControlUnit.DB,
		Min = -100,
		Max = 20,
		PinStyle = PinStyle.BOTH,
	})

	table.insert(ctrls, {
		Name = "Increase",
		ControlType = ControlType.BUTTON,
		ButtonType = ButtonType.MOMENTARY,
		IconType = "Icon",
		Icon = "Plus",
		IconColor = { 0, 0, 0 },
	})

	table.insert(ctrls, {
		Name = "Decrease",
		ControlType = ControlType.BUTTON,
		ButtonType = ButtonType.MOMENTARY,
		IconType = "Icon",
		Icon = "Minus",
		IconColor = { 0, 0, 0 },
	})

	return ctrls
end

--*** Design-time: Layout ***

function GetControlLayout(props)
	local layout = {}
	local graphics = {}
	local left = -4
	local top = -4

	layout['Ref'] = {
		PrettyName = "Ref Level",
		Style = LayoutStyle.BUTTON,
		ButtonStyle = ButtonStyle.MOMENTARY,
		Color = { 242, 137, 174 },
		Size = { 36, 16 },
		Position = { left + 26, top + 48 },
	}
	layout['Level'] = {
		PrettyName = 'Dolby Level',
		Style = LayoutStyle.KNOB,
		Color = { 0, 226, 113 },
		Position = { left + 90, top + 28 },
		Size = { 36, 36 },
	}
	layout['Increase'] = {
		PrettyName = "Increase",
		Style = LayoutStyle.BUTTON,
		ButtonStyle = ButtonStyle.MOMENTARY,
		Color = { 255, 255, 255 },
		Position = { left + 154, top + 28 },
		Size = { 36, 16 },
	}
	layout['Decrease'] = {
		PrettyName = "Decrease",
		Style = LayoutStyle.BUTTON,
		ButtonStyle = ButtonStyle.MOMENTARY,
		Color = { 255, 255, 255 },
		Size = { 36, 16 },
		Position = { left + 154, top + 48 },
	}
	layout["Gain"] = {
		PrettyName = "Gain",
		Style = LayoutStyle.KNOB,
		Position = { left + 214, top + 28 },
		Size = { 36, 36 },
	}

	graphics = {
		{
			Type = GraphicType.GROUP_BOX,
			Text = "Knob",
			HTextAlign = HTextAlign.LEFT,
			StrokeWidth = 1,
			CornerRadius = 8,
			Position = { left + 8, top + 8 },
			Size = { 265, 100 },
		},
		{
			Type = GraphicType.LABEL,
			Text = "Reference",
			Position = { left + 12, top + 72 },
			Size = { 64, 16 },
		},
		{
			Type = GraphicType.LABEL,
			Text = "Dolby\nLevel",
			Position = { left + 76, top + 72 },
			Size = { 64, 32 },
		},
		{
			Type = GraphicType.LABEL,
			Text = "Inc/Dec",
			Position = { left + 140, top + 72 },
			Size = { 64, 16 },
		},
		{
			Type = GraphicType.LABEL,
			Text = "RMS Level (dBFS)",
			Position = { left + 202, top + 72 },
			Size = { 64, 32 },
		},
	}

	return layout, graphics
end

--*** Design-time: Components, Pins, Wiring ***

function GetComponents(props)
	local comps = {}
	table.insert(comps, {
		Name = "Step",
		Type = "stepper",
		Properties = {
			control_type = 2, --// Integer
			num_steps = 100,
		},
	})
	return comps
end

-- CHANGELOG
-- v2.0.0.0 (2026-07-27)
--   refactor: Rebuilt to the QSC-derived plugin structure/naming convention --
--     mandatory section order, PascalCase Controls/fns/globals, camelCase
--     locals, centralized enums via qsys_enums.lua, CHANGELOG block moved
--     inside the plugin file (was git-log-only before)
--   breaking: Controls renamed Ref/Level/Gain/Increase/Decrease (were
--     ref/level/gain/increase/decrease) -- a design already wired to the old
--     pin names needs those pins reconnected after updating the plugin
--   bugfix: GetControlLayout had a 'ButtonStype' typo on Ref/Increase/Decrease
--     (should be 'ButtonStyle'), so those three buttons rendered with the
--     default style instead of the intended Momentary style
--   bugfix: GetProperties() returned the undefined global 'props' (always
--     nil); now returns {} explicitly
-- v1.1.0.1 (2020-09) - see git history for pre-2026-07-27 changes

if not Controls and Reflect then return end

require "dolbyfader"
