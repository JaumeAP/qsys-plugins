function GetComponents(props)
	return { { Name = "Sine", Type = "sine" } }
end

local function getPinsNames(props)
	local names = {}
	if props.Type.Value == "Multi-channel" then
		for num = 1, props.Count.Value do
			table.insert(names, string.format("Output Channel %i", num))
		end
	elseif props.Type.Value == "Stereo" then
		table.insert(names, "Output Left")
		table.insert(names, "Output Right")
	else
		table.insert(names, "Output")
	end
	return names
end

function GetPins(props)
	local pins = {}
	local names = getPinsNames(props)
	for _, name in pairs(names) do
		table.insert(pins, { Name = name, Direction = "output" })
	end
	return pins
end

function GetWiring(props)
	local wiring = {}
	local names = getPinsNames(props)
	for _, name in pairs(names) do
		table.insert(wiring, { "Sine Output", name })
	end
	return wiring
end

if not Controls and Reflect then return end

-- Dev-only safety net: catches a typo'd global (e.g. reading 'Controlls')
-- immediately instead of silently creating/reading nil. Dropped from the
-- production build automatically -- everything after the guard line is
-- discarded by build_distributable.sh in favor of the explicitly inlined
-- module list, so this never ships.
require "strict"
Global("QKnob", "period", "timer")

require "dolbysweep"
