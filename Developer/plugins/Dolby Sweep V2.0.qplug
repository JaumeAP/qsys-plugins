			ButtonType = ButtonType.TRIGGER,
			UserPin = true,
			PinStyle = PinStyle.BOTH,
		},
		{
			Name = "Mute",
			ControlType = ControlType.BUTTON,
			ButtonType = ButtonType.TOGGLE,
			UserPin = true,
			PinStyle = PinStyle.BOTH,
		},
		{
			Name = "Period",
			ControlType = ControlType.TEXT,
		},
		{
			Name = "Frequency",
			ControlType = ControlType.KNOB,
			ControlUnit = ControlUnit.HZ,
			Min = 10,
			Max = 22000,
			UserPin = true,
			PinStyle = PinStyle.OUTPUT,
		},
		{
			Name = "Level",
			ControlType = ControlType.KNOB,
			ControlUnit = ControlUnit.DB,
			Min = -100,
			Max = 20,
			UserPin = true,
			PinStyle = PinStyle.BOTH,
