--*** File header comment ***
-- Dolby Sweep Generator Plugin for Q-SYS
-- by James Puig / james.puig@dolby.com
-- Jul '20
-- v2.0: rebuilt to the QSC-derived plugin structure/naming convention (see
-- CHANGELOG block below). Signal chain: an embedded 'Sine' component swept
-- log-linearly across OCTAVE decades on a Timer, gated by Enable/Trigger/
-- Mute, driven from dolbysweep.lua.

--*** PluginInfo ***

PluginInfo =
{
	Name = "Dolby~Dolby Sweep",
	Version = "2.0",
	BuildVersion = "2.0.0.0",
	Id = "0e5ea38f-6c26-469b-aa3b-00503f1f263a",
	Description = "Dolby Sweep Generator",
	Manufacturer = "Dolby",
	Author = "James Puig - james.puig@dolby.com",
	Type = Reflect and Reflect.Types.AudioIO or 0,
}

-- Enums are needed at design time (GetControls/GetControlLayout), so this
-- module is required unconditionally, before the runtime guard below --
-- unlike the rest of Developer/Modules, which only loads after it.
require "qsys_enums"

--*** Design-time: Identity ***

function GetColor(props)
	return { 164, 212, 176 } --Is Audio
end

function GetPrettyName(props)
	return "Dolby Sweep Generator"
end

--*** Design-time: Properties ***

function GetProperties()
	return {
		{
			Name = "Type",
			Type = PropertyType.ENUM,
			Choices = { "Mono", "Stereo", "Multi-channel" },
			Value = "Mono",
		},
		{
			Name = "Count",
			Type = PropertyType.INTEGER,
			Value = 8,
			Min = 2,
			Max = 256,
		},
	}
end

function RectifyProperties(props)
	props.Count.IsHidden = props.Type.Value ~= "Multi-channel"
	props.plugin_show_debug.IsHidden = true
	return props
end

