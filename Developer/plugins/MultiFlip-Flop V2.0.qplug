--*** File header comment ***
-- Multi Flip-Flop for Q-SYS
-- by James Puig / james.puig@dolby.com
-- Jul '20
-- v2.0: rebuilt to the QSC-derived plugin structure/naming convention (see
-- CHANGELOG block below). Runtime logic stays inline in this file (the one
-- exception in this repo -- see CLAUDE.md), guarded by `if Controls then`,
-- which already matched the spec's own guard style before this rewrite.

--*** PluginInfo ***

PluginInfo = {
	Name = "Dolby~Multi Flip-Flop",
	Version = "2.0",
	BuildVersion = "2.0.0.0",
	Id = "8d8af033-fa93-4962-805a-96d57b435859",
	Author = "Jaume Puig",
	Description = "Advanced Multi Flip-Flop Component Plugin",
}

-- Enums are needed at design time (GetControls/GetControlLayout), so this
-- module is required unconditionally, before the runtime guard below --
-- unlike the rest of Developer/Modules, which only loads after it.
require "qsys_enums"

--*** Design-time: Identity ***

function GetColor(props)
	return { 204, 204, 204 }
end

function GetPrettyName(props)
	return "Multi Flip-Flop "
end

--*** Design-time: Properties ***

function GetProperties()
	local props = {}
	table.insert(props, {
		Name = "InputCount", -- property names may not contain spaces (was "Input Count")
		Type = PropertyType.INTEGER,
		Value = 1,
		Min = 1,
		Max = 256,
	})
	return props
end

function RectifyProperties(props)
	props.plugin_show_debug.IsHidden = true
	return props
end

--*** Design-time: Controls ***

function GetControls(props)
	local ctrls = {}

	table.insert(ctrls, {
		Name = "Start",
		ControlType = ControlType.BUTTON,
		ButtonType = ButtonType.TOGGLE,
	})

	table.insert(ctrls, {
		Name = "Exclusive",
		ControlType = ControlType.BUTTON,
		ButtonType = ButtonType.TOGGLE,
	})

	for t = 1, props["InputCount"].Value do
		table.insert(ctrls, {
			Name = "Set_" .. t,
			ControlType = ControlType.BUTTON,
			ButtonType = ButtonType.TRIGGER,
			UserPin = true,
			PinStyle = PinStyle.BOTH,
		})

		table.insert(ctrls, {
			Name = "Reset_" .. t,
			ControlType = ControlType.BUTTON,
			ButtonType = ButtonType.TRIGGER,
			UserPin = true,
			PinStyle = PinStyle.BOTH,
		})

		table.insert(ctrls, {
			Name = "Toggle_" .. t,
			ControlType = ControlType.BUTTON,
			ButtonType = ButtonType.TRIGGER,
			UserPin = true,
			PinStyle = PinStyle.BOTH,
		})

		table.insert(ctrls, {
			Name = "State_" .. t,
			ControlType = ControlType.BUTTON,
			ButtonType = ButtonType.TOGGLE,
			UserPin = true,
			PinStyle = PinStyle.BOTH,
		})

		table.insert(ctrls, {
			Name = "Led_" .. t,
			ControlType = ControlType.INDICATOR,
			IndicatorType = IndicatorType.LED,
			Count = 2,
			UserPin = true,
			PinStyle = PinStyle.BOTH,
		})

		table.insert(ctrls, {
			Name = "Out_" .. t,
			ControlType = ControlType.INDICATOR,
			IndicatorType = IndicatorType.LED,
			UserPin = true,
			PinStyle = PinStyle.OUTPUT,
		})

		table.insert(ctrls, {
			Name = "Not_" .. t,
			ControlType = ControlType.INDICATOR,
			IndicatorType = IndicatorType.LED,
			UserPin = true,
			PinStyle = PinStyle.OUTPUT,
		})
	end
	return ctrls
end

--*** Design-time: Layout ***

function GetControlLayout(props)
	local layout = {}
	local graphics = {}
	local top = 20

	table.insert(graphics, {
		Type = GraphicType.LABEL,
		Text = "Exclusive",
		StrokeWidth = 0,
		VTextAlign = VTextAlign.CENTER, -- FIX: was 'VAlign = Center' (wrong key, undefined global)
		Position = { 144, 0 },
		Size = { 64, 16 },
	})

	table.insert(graphics, {
		Type = GraphicType.LABEL,
		Text = "Set",
		StrokeWidth = 0,
		VTextAlign = VTextAlign.CENTER,
		Position = { 36 * 1, top },
		Size = { 36, 32 },
	})

	table.insert(graphics, {
		Type = GraphicType.LABEL,
		Text = "Reset",
		StrokeWidth = 0,
		VTextAlign = VTextAlign.CENTER,
		Position = { 36 * 2, top },
		Size = { 36, 32 },
	})

	table.insert(graphics, {
		Type = GraphicType.LABEL,
		Text = "Toggle",
		StrokeWidth = 0,
		VTextAlign = VTextAlign.CENTER,
		Position = { 36 * 3, top },
		Size = { 36, 32 },
	})

	table.insert(graphics, {
		Type = GraphicType.LABEL,
		Text = "State",
		StrokeWidth = 0,
		VTextAlign = VTextAlign.CENTER,
		Position = { 36 * 4, top },
		Size = { 36, 32 },
	})

	table.insert(graphics, {
		Type = GraphicType.LABEL,
		Text = "Out",
		VTextAlign = VTextAlign.CENTER,
		StrokeWidth = 0,
		Position = { 36 * 5 + 4, top },
		Size = { 36, 32 },
	})

	table.insert(graphics, {
		Type = GraphicType.LABEL,
		Text = "Not Out",
		StrokeWidth = 0,
		VTextAlign = VTextAlign.CENTER,
		Position = { 36 * 6 + 8, top },
		Size = { 36, 32 },
	})

	for t = 1, props["InputCount"].Value do
		table.insert(graphics, {
			Type = GraphicType.LABEL,
			Text = tostring(t),
			StrokeWidth = 0,
			Position = { 0, top + (t + 1) * 16 },
			Size = { 32, 16 },
		})

		layout['Exclusive'] = { PrettyName = "Exclusive", Position = { 210, 0 } }
		layout['Set_' .. t] = { PrettyName = tostring(t) .. "~Set", Position = { 36 * 1, top + (t + 1) * 16 } }
		layout['Reset_' .. t] = { PrettyName = tostring(t) .. "~Reset", Position = { 36 * 2, top + (t + 1) * 16 } }
		layout['Toggle_' .. t] = { PrettyName = tostring(t) .. "~Toggle", Position = { 36 * 3, top + (t + 1) * 16 } }
		layout['State_' .. t] = { PrettyName = tostring(t) .. "~State", Position = { 36 * 4, top + (t + 1) * 16 } }
		layout['Out_' .. t] = { PrettyName = tostring(t) .. "~Out", Position = { 36 * 5 + 16, top + (t + 1) * 16 } }
		layout['Not_' .. t] = { PrettyName = tostring(t) .. "~Not out", Position = { 36 * 6 + 16, top + (t + 1) * 16 } }
	end
	return layout, graphics
end

-- CHANGELOG
-- v2.0.0.0 (2026-07-27)
--   refactor: Rebuilt to the QSC-derived plugin structure/naming convention --
--     mandatory section order, PascalCase Controls/fns/globals, camelCase
--     locals, centralized enums via qsys_enums.lua, CHANGELOG block moved
--     inside the plugin file
--   breaking: Controls renamed to PascalCase (Start/Exclusive/Set_N/Reset_N/
--     Toggle_N/State_N/Led_N/Out_N/Not_N, were lowercase) and the "Input
--     Count" property renamed to "InputCount" (property names may not
--     contain spaces per the plugin spec; a control name may, a property
--     name may not) -- a design already wired to the old pin/property
--     names needs those reconnected after updating
--   bugfix: every layout Label used 'VAlign = Center', which is not a real
--     layout key (the real one is VTextAlign) and 'Center' was never a
--     declared value anywhere in the file (an undeclared global, so the
--     whole assignment was `VTextAlign = nil`) -- vertical centering on
--     these labels was silently never applied; now VTextAlign=VTextAlign.CENTER
-- v1.0.1.31 (2020-07) - see git history for pre-2026-07-27 changes

--*** Runtime ***
-- Inline (the one plugin in this repo without a separate Modules/ file).

if Controls then

	--*** Custom functions ***

	local function reset(t)
		if Controls.Exclusive.Value == 0 then return end
		for v = 1, Properties["InputCount"].Value do
			if v ~= t then
				Controls["Reset_" .. v]:Trigger()
				Controls["State_" .. v].Value = 0
				Controls['Out_' .. v].Value = 0
				Controls['Not_' .. v].Value = 1
			end
		end
	end

	--*** Event handlers ***

	Controls.Exclusive.EventHandler = function(ctrl)
		local first = false
		for t = 1, Properties["InputCount"].Value do
			if first then
				Controls["State_" .. t].Value = 0
				Controls["Reset_" .. t]:Trigger()
				Controls['Out_' .. t].Value = 0
				Controls['Not_' .. t].Value = 1
			elseif Controls["State_" .. t].Value == 1 then
				first = true
			end
		end
	end

	for t = 1, Properties["InputCount"].Value do

		Controls["State_" .. t].EventHandler = function(ctrl)
			reset(t)
			if Controls["State_" .. t].Value == 1 then
				Controls["Set_" .. t]:Trigger()
				Controls['Out_' .. t].Value = 1
				Controls['Not_' .. t].Value = 0
			else
				Controls["Reset_" .. t]:Trigger()
				Controls['Out_' .. t].Value = 0
				Controls['Not_' .. t].Value = 1
			end
		end

		Controls["Set_" .. t].EventHandler = function(ctrl)
			reset(t)
			Controls["State_" .. t].Value = 1
			Controls['Out_' .. t].Value = 1
			Controls['Not_' .. t].Value = 0
		end

		Controls["Reset_" .. t].EventHandler = function(ctrl)
			Controls["State_" .. t].Value = 0
			Controls['Out_' .. t].Value = 0
			Controls['Not_' .. t].Value = 1
		end

		Controls["Toggle_" .. t].EventHandler = function(ctrl)
			Controls["State_" .. t].Value = Controls["State_" .. t].Value == 0
			Controls["State_" .. t].EventHandler()
		end

	end

	--*** Init ***

	for t = 1, Properties["InputCount"].Value do
		if Controls["State_" .. t].Value == 1 then
			Controls["Set_" .. t]:Trigger()
			Controls['Out_' .. t].Value = 1
			Controls['Not_' .. t].Value = 0
		else
			Controls["Reset_" .. t]:Trigger()
			Controls['Out_' .. t].Value = 0
			Controls['Not_' .. t].Value = 1
		end
	end
end
